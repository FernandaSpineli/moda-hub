# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

# Matches the local-only credentials in docker-compose.yml.
DATABASE_URL=postgres://moda:moda@localhost:5432/moda
REDIS_URL=redis://localhost:6379/0

# Host ports used by docker compose (change if they are taken).
APP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
