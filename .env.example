# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

APP_BASE_URL=http://localhost:3000

# Ed25519 key that signs access tokens. Generate one with:
#   node scripts/generate-jwt-key.mjs
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m

# How long stock stays reserved for an order awaiting payment.
ORDER_RESERVATION_TTL=30m

# Stripe (test mode). Leave both empty to run without payments.
#   STRIPE_SECRET_KEY:     Dashboard > Developers > API keys (sk_test_...)
#   STRIPE_WEBHOOK_SECRET: printed by the Stripe CLI (docker compose logs stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Matches the local-only credentials in docker-compose.yml.
DATABASE_URL=postgres://moda:moda@localhost:5432/moda
REDIS_URL=redis://localhost:6379/0

# Host ports used by docker compose (change if they are taken).
APP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
